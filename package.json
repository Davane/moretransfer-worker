{
  "name": "moretransfer-worker",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "login": "login",
    "dev": "wrangler dev --env dev",
    "dev:cron": "wrangler dev --env dev --test-scheduled",
    "dev:no-auth": "wrangler dev --env dev --var \"SKIP_REQUEST_VERIFICATION:true\"",
    "cron:cleanup": "curl \"http://localhost:8787/__scheduled?cron=0+*%2F3+*+*+*\"",
    "cron:abandoned-uploads": "curl \"http://localhost:8787/__scheduled?cron=0+1%2C7%2C13%2C19+*+*+*\"",
    "cron:email:reminder": "curl \"http://localhost:8787/__scheduled?cron=0+9+*+*+*\"",
    "cron:email:digest": "curl \"http://localhost:8787/__scheduled?cron=*%2F30+*+*+*+*\"",
    "r2:put": "sh ./scripts/put-object.sh",
    "r2:list": "sh ./scripts/list-objects.sh",
    "r2:get": "sh ./scripts/get-objects.sh",
    "enqueue": "sh ./scripts/test-enqueue.sh",
    "unzip": "unzip -l /tmp/tr_demo.zip",
    "typecheck": "tsc --noEmit",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:prod": "wrangler deploy --env prod",
    "queue:create": "wrangler queues create <queue-name>",
    "secret:create:prod": "wrangler secret put <SECRET_NAME> --env prod",
    "secret:create:dev": "wrangler secret put <SECRET_NAME> --env dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@cloudflare/containers": "^0.3.3",
    "@cloudflare/workers-types": "^4.20260507.1"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "wrangler": "^4.31.0"
  }
}
